# ===== 应用 =====
APP_NAME=宠物洗护门店预约与洗护档案智能体
APP_VERSION=8.6.2
DEBUG=true
API_PREFIX=/api/v1

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yeyaoyan
MYSQL_DB=pet_groom

# ===== JWT =====
JWT_SECRET=pet-groom-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 手机号 AES 可逆加密（留空则从 JWT_SECRET 派生）=====
PHONE_AES_KEY=

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ===== LLM：阿里云百炼（DashScope）免费额度模型 =====
# 模型来源：百炼控制台「费用与配额 - 免费额度」页面
# https://bailian.console.aliyun.com/cn-beijing/costing-balance/free-quota
# 免费额度模型清单会随活动调整，请以控制台实际展示为准，并在此处覆盖模型名。
# 未填 API Key 时系统自动降级为规则引擎，业务不受影响。
LLM_ENABLED=true
LLM_PROVIDER=bailian
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 主模型：qwen3.7-max（qwen-max 免费额度已用尽且不再使用；glm-5.2 content 恒空，勿用）
LLM_MODEL=qwen3.7-max-2026-06-08
# 备选链：能力强的慢模型在前，跨厂商 glm 兜底；glm-5.2 返回内容恒为空，勿用
LLM_FALLBACK_MODELS=glm-5.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
AGENT_MAX_STEPS=6

# ===== RAG：LlamaIndex + Chroma + 百炼 embedding =====
# 实测（2026-10-20）：text-embedding-v4 最快（336ms/1024 维），qwen3.7-text-embedding 备选；
# qwen3-vl-embedding 与 text-embedding-async-v1/v2 在兼容模式不可用（前者需多模态接口，后者是异步批量）
EMBED_MODEL=text-embedding-v4
EMBED_FALLBACK_MODELS=qwen3.7-text-embedding
EMBED_TIMEOUT_SECONDS=15
CHROMA_DIR=data/chroma
# 召回后重排（可选）：qwen3-rerank / qwen3-vl-rerank / gte-rerank-v2
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_SECONDS=10

# ===== 知识库文档上传与切块 =====
KB_UPLOAD_DIR=data/knowledge_uploads
KB_ALLOWED_EXTENSIONS=pdf,docx,txt,md,markdown
KB_MAX_FILE_MB=20
KB_MAX_BATCH_FILES=5
KB_DEFAULT_CHUNK_STRATEGY=heading
KB_DEFAULT_CHUNK_SIZE=500
KB_DEFAULT_CHUNK_OVERLAP=50
KB_MIN_CHUNK_SIZE=100
KB_MAX_CHUNK_SIZE=4000
KB_MAX_CHUNK_OVERLAP=1000
KB_MAX_CONCURRENT_TASKS=2

# ===== 营业时段 =====
DEFAULT_SLOT_START_HOUR=9
DEFAULT_SLOT_END_HOUR=19
SLOT_MINUTES=60

# ===== 定时任务（进程内置调度器；生产可换 arq，任务函数不变）=====
TASK_SCHEDULER_ENABLED=true
TASK_SLA_INTERVAL_MINUTES=15
TASK_REMINDER_INTERVAL_MINUTES=720
TASK_CLEANUP_INTERVAL_MINUTES=1440

# ===== 会话级并发锁（同一会话的并发消息串行化）=====
# 单进程语义；多实例部署需换 Redis 分布式锁（见 docs/09 已知限制）
CHAT_SESSION_LOCK_ENABLED=true
CHAT_SESSION_LOCK_WAIT_SECONDS=20
